<Window x:Class="AutoWifi.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Wifi"
        Icon="Assets/app.ico"
        Width="440"
        Height="640"
        MinWidth="420"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Text="Auto-Wifi" />
      <TextBlock x:Name="SubtitleText" Foreground="Gray" Margin="0,4,0,0" />
    </StackPanel>

    <TabControl Grid.Row="1" x:Name="Tabs">
      <TabItem x:Name="StatusTab" Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,16,4,4">
            <TextBlock x:Name="CurrentSsidLabel" Foreground="Gray" />
            <TextBlock x:Name="CurrentSsidValue" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="RoleValue" Foreground="Gray" Margin="0,4,0,0" />

            <Separator Margin="0,14" />

            <CheckBox x:Name="AutoSwitchCheckBox"
                      Checked="AutoSwitch_Changed"
                      Unchecked="AutoSwitch_Changed"
                      FontWeight="SemiBold" />
            <TextBlock x:Name="AutoSwitchHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock x:Name="NextCheckLabel" Foreground="Gray" Margin="0,14,0,0" />
            <TextBlock x:Name="NextCheckValue" FontSize="16" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="ScanButton" Click="ScanButton_Click" />
              <Button x:Name="RefreshButton" Click="RefreshButton_Click" />
            </StackPanel>

            <TextBlock x:Name="LastMessageText" Foreground="Gray" TextWrapping="Wrap" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="NetworksTab" Header="Networks">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,16,4,4">
            <TextBlock x:Name="NetworksDescription" TextWrapping="Wrap" Foreground="Gray" />

            <TextBlock x:Name="PriorityLabel" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ComboBox x:Name="PrioritySsidBox" IsEditable="True" Margin="0,4,0,10" />
            <PasswordBox x:Name="PriorityPasswordBox" />

            <TextBlock x:Name="BackupLabel" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="BackupSsidBox" IsEditable="True" Margin="0,4,0,10" />
            <PasswordBox x:Name="BackupPasswordBox" />

            <CheckBox x:Name="ShowPasswordsCheckBox"
                      Checked="ShowPasswords_Changed"
                      Unchecked="ShowPasswords_Changed"
                      Margin="0,0,0,8" />

            <TextBlock x:Name="ScanHint" Foreground="Gray" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="ScanNetworksButton" Click="ScanNetworksButton_Click" />
              <TextBlock x:Name="ScanStatusText" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="SaveButton" Click="SaveButton_Click" Margin="0,16,0,0" />
            <TextBlock x:Name="ValidationText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="NetworkHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="SettingsTab" Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,16,4,4">
            <TextBlock x:Name="GeneralLabel" FontWeight="SemiBold" />
            <TextBlock x:Name="LanguageLabel" Foreground="Gray" Margin="0,14,0,0" />
            <ComboBox x:Name="LanguageCombo" Width="180" SelectionChanged="LanguageCombo_SelectionChanged" />

            <TextBlock x:Name="IntervalLabel" Foreground="Gray" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="IntervalBox" Width="100" />
              <TextBlock x:Name="SecondsLabel" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,10" />
            </StackPanel>

            <CheckBox x:Name="LaunchAtLoginCheckBox"
                      Checked="LaunchAtLogin_Changed"
                      Unchecked="LaunchAtLogin_Changed" />
            <TextBlock x:Name="LaunchAtLoginHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

            <Button x:Name="RerunSetupButton" Click="RerunSetupButton_Click" Margin="0,14,0,0" />

            <Separator Margin="0,18" />
            <TextBlock x:Name="AboutLabel" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionLabel" Foreground="Gray" Margin="0,12,0,0" />
            <TextBlock x:Name="VersionValue" />
            <TextBlock x:Name="PrivacyText" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button x:Name="QuitButton" Click="QuitButton_Click" Foreground="IndianRed" Margin="0,18,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>

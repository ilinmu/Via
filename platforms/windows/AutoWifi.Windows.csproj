<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET Framework 4.8 ships with Windows 10 (1903+) and Windows 11, so the
      app needs no runtime download and the portable exe stays around 1 MB.
      WPF on .NET 8 cannot be trimmed, which made the self-contained build
      ~72 MB.
    -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Records, switch expressions, nullable reference types. -->
    <LangVersion>latest</LangVersion>
    <AssemblyName>Via</AssemblyName>
    <RootNamespace>AutoWifi.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImplicitUsings imports System.Net.Http; the framework assembly must
         be referenced explicitly. System.Runtime.Serialization backs the
         settings JSON (System.Text.Json is .NET Core only). -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />

    <!-- Guarantees the net48 reference assemblies even when the machine has no
         Visual Studio / targeting pack installed (build-time only). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\core\target\x86_64-pc-windows-msvc\release\autowifi_core.dll"
          Link="autowifi_core.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\core\target\x86_64-pc-windows-msvc\release\autowifi_core.dll')" />
    <None Include="..\..\core\target\release\autowifi_core.dll"
          Link="autowifi_core.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\core\target\release\autowifi_core.dll')" />
  </ItemGroup>

  <!--
    The portable build ships a single exe, so the native policy core is
    embedded and extracted at startup (see NativeCore.cs). The None copies
    above still serve dev builds and the xUnit project.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\core\target\x86_64-pc-windows-msvc\release\autowifi_core.dll"
                      LogicalName="autowifi_core.dll"
                      Condition="Exists('..\..\core\target\x86_64-pc-windows-msvc\release\autowifi_core.dll')" />
    <EmbeddedResource Include="..\..\core\target\release\autowifi_core.dll"
                      LogicalName="autowifi_core.dll"
                      Condition="Exists('..\..\core\target\release\autowifi_core.dll') And !Exists('..\..\core\target\x86_64-pc-windows-msvc\release\autowifi_core.dll')" />
  </ItemGroup>

</Project>

<Window x:Class="AutoWifi.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Wifi"
        Icon="Assets/app.ico"
        Width="460"
        Height="600"
        MinWidth="420"
        MinHeight="520"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE701;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="17"
                     Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="WizardTitle"
                     Style="{StaticResource HeaderTitle}"
                     Margin="9,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="StepText"
                   Grid.Column="1"
                   Style="{StaticResource Caption}"
                   VerticalAlignment="Center" />
      </Grid>
      <ProgressBar x:Name="Progress"
                   Style="{StaticResource ThinProgressBar}"
                   Margin="0,12,0,0"
                   Minimum="0"
                   Maximum="3" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,18,24,0">
      <Grid>
        <StackPanel x:Name="StepWelcome">
          <TextBlock x:Name="WelcomeTitle"
                     Style="{StaticResource PageTitle}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="WelcomeBody"
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel x:Name="StepNetworks" Visibility="Collapsed">
          <TextBlock x:Name="NetworksTitle"
                     Style="{StaticResource PageTitle}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="NetworksBody"
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ScanStatus"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <Button x:Name="ScanButton"
                    Grid.Column="1"
                    Style="{StaticResource BorderedButton}"
                    Click="ScanButton_Click" />
          </Grid>

          <TextBlock x:Name="PriorityLabel"
                     Style="{StaticResource SectionHeader}"
                     Margin="0,18,0,0" />
          <ComboBox x:Name="PriorityCombo"
                    Style="{StaticResource RoundedComboBox}"
                    IsEditable="True"
                    Margin="0,6,0,0" />
          <PasswordBox x:Name="PriorityPassword"
                       Style="{StaticResource RoundedPasswordBox}"
                       Margin="0,8,0,0" />

          <TextBlock x:Name="BackupLabel"
                     Style="{StaticResource SectionHeader}"
                     Margin="0,16,0,0" />
          <ComboBox x:Name="BackupCombo"
                    Style="{StaticResource RoundedComboBox}"
                    IsEditable="True"
                    Margin="0,6,0,0" />
          <PasswordBox x:Name="BackupPassword"
                       Style="{StaticResource RoundedPasswordBox}"
                       Margin="0,8,0,0" />

          <TextBlock x:Name="PasswordHint"
                     Style="{StaticResource TertiaryCaption}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />
          <TextBlock x:Name="Validation"
                     Style="{StaticResource Caption}"
                     Foreground="{DynamicResource DangerBrush}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel x:Name="StepFinish" Visibility="Collapsed">
          <TextBlock x:Name="FinishTitle"
                     Style="{StaticResource PageTitle}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="FinishBody"
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />

          <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock x:Name="SummaryP" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
              <Border Style="{StaticResource Divider}" Margin="0,10" />
              <TextBlock x:Name="SummaryB" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="FinishHint"
                     Style="{StaticResource TertiaryCaption}"
                     TextWrapping="Wrap"
                     Margin="0,16,0,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="24,18,24,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              Grid.Column="0"
              Style="{StaticResource BorderedButton}"
              Click="Back_Click"
              Visibility="Collapsed" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="SkipButton"
                Style="{StaticResource LinkButton}"
                Foreground="{DynamicResource SecondaryTextBrush}"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                Click="Skip_Click" />
        <Button x:Name="NextButton"
                Style="{StaticResource PrimaryButton}"
                Click="Next_Click" />
        <Button x:Name="SaveOnlyButton"
                Style="{StaticResource BorderedButton}"
                Visibility="Collapsed"
                Click="SaveOnly_Click" />
        <Button x:Name="StartButton"
                Style="{StaticResource PrimaryButton}"
                Visibility="Collapsed"
                Margin="8,0,0,0"
                Click="Start_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
